# Maintainer: ArchPad project
pkgname=archpad-agent-manager
pkgver=1.0.0
pkgrel=3
pkgdesc='AGY / Claude / Codex agent session monitor Plasma plasmoid for ArchPad'
arch=('any')
url='https://github.com/Sachinmc73/archpad-pipa'
license=('GPL-3.0-or-later')
depends=(
    'plasma-workspace>=6.7.5'
    'kirigami'
    'python3'
    'konsole'
)
options=('!strip')

package() {
    local _dest="$pkgdir/usr/share/plasma/plasmoids/com.archpad.agentmanager"

    install -d "$_dest"
    install -Dm755 "$startdir/archpad-agent-manager-provider" "$pkgdir/usr/bin/archpad-agent-manager-provider"
    install -Dm644 "$startdir/metadata.json" "$_dest/metadata.json"

    install -d "$_dest/contents/ui"
    install -Dm644 "$startdir/contents/ui/main.qml"                  "$_dest/contents/ui/main.qml"
    install -Dm644 "$startdir/contents/ui/CompactRepresentation.qml" "$_dest/contents/ui/CompactRepresentation.qml"
    install -Dm644 "$startdir/contents/ui/FullRepresentation.qml"    "$_dest/contents/ui/FullRepresentation.qml"
    install -Dm755 "$startdir/contents/ui/agy-data-provider.py"      "$_dest/contents/ui/agy-data-provider.py"

    install -d "$_dest/contents/ui/icons"
    cp -a "$startdir/contents/ui/icons/." "$_dest/contents/ui/icons/"

    find "$_dest" -type d -exec chmod 0755 {} +
    find "$_dest/contents/ui/icons" -type f -exec chmod 0644 {} +
}
