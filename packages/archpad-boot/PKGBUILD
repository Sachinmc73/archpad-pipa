package() {
  install -Dm644 "${srcdir}/archpad-userdata.install" "${pkgdir}/usr/lib/initcpio/install/archpad-userdata"
  install -Dm644 "${srcdir}/archpad-userdata.hook" "${pkgdir}/usr/lib/initcpio/hooks/archpad-userdata"
