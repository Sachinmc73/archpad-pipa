+
+void PlasmaCamera::setFocusPosition(int pos)
+{
+    if (m_focusFd < 0) {
+        return;
+    }
+
+    pos = std::clamp(pos, m_focusMin, m_focusMax);
+    struct v4l2_control ctrl;
+    memset(&ctrl, 0, sizeof(ctrl));
+    ctrl.id = V4L2_CID_FOCUS_ABSOLUTE;
+    ctrl.value = pos;
+    if (::ioctl(m_focusFd, VIDIOC_S_CTRL, &ctrl) == 0) {
+        m_focusPosition = pos;
+        Q_EMIT focusPositionChanged();
+    } else {
+        qWarning() << "Failed to set focus position" << pos << ":" << strerror(errno);
+    }
+}
+
+void PlasmaCamera::setSoftwareRotationDegrees(int deg)
+{
+    deg = ((deg % 360) + 360) % 360;
+    if (m_softwareRotationDegrees != deg) {
+        m_softwareRotationDegrees = deg;
+        Q_EMIT softwareRotationDegreesChanged();
+    }
+}
+
+void PlasmaCamera::cycleRotation()
+{
+    setSoftwareRotationDegrees(m_softwareRotationDegrees + 90);
+}
+
+void PlasmaCamera::initFocusActuator()
+{
+    cleanupFocusActuator();
+
+    QDir dir(QStringLiteral("/sys/class/video4linux"));
+    const QStringList subdevs = dir.entryList(QStringList() << QStringLiteral("v4l-subdev*"), QDir::Dirs);
+    QString vcmPath;
+
+    for (const QString &subdev : subdevs) {
+        QFile nameFile(dir.filePath(subdev + QStringLiteral("/name")));
+        if (nameFile.open(QIODevice::ReadOnly | QIODevice::Text)) {
+            QString name = QString::fromUtf8(nameFile.readAll()).trimmed();
+            nameFile.close();
+            if (name.contains(QStringLiteral("dw9768"), Qt::CaseInsensitive) ||
+                name.contains(QStringLiteral("vcm"), Qt::CaseInsensitive) ||
+                name.contains(QStringLiteral("focus"), Qt::CaseInsensitive)) {
+                vcmPath = QStringLiteral("/dev/") + subdev;
+                qInfo() << "Found focus VCM subdevice:" << vcmPath << "(" << name << ")";
+                break;
+            }
+        }
+    }
+
+    if (vcmPath.isEmpty()) {
+        qWarning() << "No VCM focus subdevice found";
+        return;
+    }
+
+    int fd = ::open(vcmPath.toUtf8().constData(), O_RDWR | O_NONBLOCK);
+    if (fd < 0) {
+        qWarning() << "Failed to open VCM device" << vcmPath << ":" << strerror(errno);
+        return;
+    }
+
+    struct v4l2_queryctrl qctrl;
+    memset(&qctrl, 0, sizeof(qctrl));
+    qctrl.id = V4L2_CID_FOCUS_ABSOLUTE;
+    if (::ioctl(fd, VIDIOC_QUERYCTRL, &qctrl) == 0 && !(qctrl.flags & V4L2_CTRL_FLAG_DISABLED)) {
+        m_focusFd = fd;
+        m_focusMin = qctrl.minimum;
+        m_focusMax = qctrl.maximum;
+        m_focusStep = qctrl.step > 0 ? qctrl.step : 1;
+        m_focusSupported = true;
+        qInfo() << "VCM focus supported, range [" << m_focusMin << ".." << m_focusMax << "], step" << m_focusStep;
+
+        // Apply default hyperfocal focus (450)
+        setFocusPosition(m_focusPosition);
+        Q_EMIT focusSupportedChanged();
+    } else {
+        qWarning() << "V4L2_CID_FOCUS_ABSOLUTE not supported on" << vcmPath;
+        ::close(fd);
+    }
+}
+
+void PlasmaCamera::cleanupFocusActuator()
+{
+    if (m_autoFocusRunning) {
+        m_autoFocusRunning = false;
+        Q_EMIT autoFocusRunningChanged();
+    }
+    if (m_focusFd >= 0) {
+        ::close(m_focusFd);
+        m_focusFd = -1;
+    }
+    if (m_focusSupported) {
+        m_focusSupported = false;
+        Q_EMIT focusSupportedChanged();
+    }
+}
+
+static double computeImageSharpness(const QImage &img)
+{
+    if (img.isNull() || img.width() < 64 || img.height() < 64) {
+        return 0.0;
+    }
+
+    int w = img.width();
+    int h = img.height();
+    int x0 = w * 3 / 8;
+    int y0 = h * 3 / 8;
+    int rw = w / 4;
+    int rh = h / 4;
+
+    double sumGrad = 0.0;
+    int count = 0;
+
+    for (int y = y0; y < y0 + rh - 1; y += 2) {
+        const uchar *line1 = img.constScanLine(y);
+        const uchar *line2 = img.constScanLine(y + 1);
+        int bpp = img.depth() / 8;
+        if (bpp < 3) continue;
+        for (int x = x0; x < x0 + rw - 1; x += 2) {
+            int p00 = line1[x * bpp + 1];
+            int p01 = line1[(x + 1) * bpp + 1];
+            int p10 = line2[x * bpp + 1];
+            int dx = p01 - p00;
+            int dy = p10 - p00;
+            sumGrad += static_cast<double>(dx * dx + dy * dy);
+            count++;
+        }
+    }
+
+    return count > 0 ? (sumGrad / count) : 0.0;
+}
+
+void PlasmaCamera::triggerAutoFocus()
+{
+    if (m_focusFd < 0 || m_autoFocusRunning) {
+        return;
+    }
+
+    qInfo() << "Starting Auto Focus sweep...";
+    m_afSweepPositions = { 100, 250, 400, 550, 700, 850 };
+    m_afStepIndex = 0;
+    m_afFrameSkip = 2;
+    m_bestAfPos = m_focusPosition;
+    m_bestAfSharpness = -1.0;
+    m_autoFocusRunning = true;
+    Q_EMIT autoFocusRunningChanged();
+
+    setFocusPosition(m_afSweepPositions[0]);
+}
+
+void PlasmaCamera::handleViewfinderFrameForAf(const QImage &frame)
+{
+    if (!m_autoFocusRunning || m_focusFd < 0) {
+        return;
+    }
+
+    if (m_afFrameSkip > 0) {
+        m_afFrameSkip--;
+        return;
+    }
+
+    double sharpness = computeImageSharpness(frame);
+    qDebug() << "AF step" << m_afStepIndex << "pos" << m_afSweepPositions.value(m_afStepIndex) << "sharpness" << sharpness;
+
+    if (sharpness > m_bestAfSharpness) {
+        m_bestAfSharpness = sharpness;
+        m_bestAfPos = m_afSweepPositions.value(m_afStepIndex);
+    }
+
+    m_afStepIndex++;
+    if (m_afStepIndex < m_afSweepPositions.size()) {
+        setFocusPosition(m_afSweepPositions[m_afStepIndex]);
+        m_afFrameSkip = 2;
+    } else {
+        qInfo() << "AF finished. Best position:" << m_bestAfPos << "sharpness:" << m_bestAfSharpness;
+        setFocusPosition(m_bestAfPos);
+        m_autoFocusRunning = false;
+        Q_EMIT autoFocusRunningChanged();
+    }
+}
