+// SPDX-License-Identifier: GPL-2.0-or-later
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.kirigami as Kirigami
+import org.kde.plasmacamera
+
+Rectangle {
+    id: root
+
+    property PlasmaCamera camera: null
+    property bool shown: false
+
+    implicitHeight: shown ? contentLayout.implicitHeight + Kirigami.Units.smallSpacing * 2 : 0
+    visible: shown
+    clip: true
+    color: Qt.rgba(0, 0, 0, 0.4)
+
+    Behavior on implicitHeight {
+        NumberAnimation { duration: 150; easing.type: Easing.InOutQuad }
+    }
+
+    RowLayout {
+        id: contentLayout
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.verticalCenter: parent.verticalCenter
+        anchors.margins: Kirigami.Units.smallSpacing
+        spacing: Kirigami.Units.smallSpacing
+
+        QQC2.Button {
+            text: i18n("Auto AF")
+            icon.name: "lensautofix"
+            enabled: root.camera ? !root.camera.autoFocusRunning : false
+            onClicked: if (root.camera) root.camera.triggerAutoFocus()
+        }
+
+        QQC2.Button {
+            text: i18n("Macro")
+            onClicked: if (root.camera) root.camera.focusPosition = 750
+        }
+
+        QQC2.Button {
+            text: i18n("Normal")
+            onClicked: if (root.camera) root.camera.focusPosition = 450
+        }
+
+        QQC2.Button {
+            text: i18n("Inf")
+            onClicked: if (root.camera) root.camera.focusPosition = 50
+        }
+
+        QQC2.Slider {
+            id: focusSlider
+            Layout.fillWidth: true
+            from: root.camera ? root.camera.focusMin : 0
+            to: root.camera ? root.camera.focusMax : 1023
+            stepSize: 10
+            value: root.camera ? root.camera.focusPosition : 450
+            onMoved: if (root.camera) root.camera.focusPosition = Math.round(value)
+        }
+
+        QQC2.Label {
+            text: root.camera ? root.camera.focusPosition.toString() : ""
+            color: "white"
+            Layout.preferredWidth: Kirigami.Units.gridUnit * 2
+        }
+    }
+}
