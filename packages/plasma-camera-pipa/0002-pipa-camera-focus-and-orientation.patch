+
+void PlasmaCamera::writeFocusHardware(int targetPos)
+{
+    if (m_focusFd >= 0) {
+        struct v4l2_control ctrl;
+        memset(&ctrl, 0, sizeof(ctrl));
+        ctrl.id = V4L2_CID_FOCUS_ABSOLUTE;
+        ctrl.value = targetPos;
+        ::ioctl(m_focusFd, VIDIOC_S_CTRL, &ctrl);
+    }
+
+    if (m_focusI2cFd < 0) {
+        return;
+    }
+
+    targetPos = std::clamp(targetPos, m_focusMin, m_focusMax);
+
+    if (m_hardwareFocusPos < 0) {
+        // First hardware write: activate DW9714 internal Linear Slope Control (s = 0x05)
+        uint16_t val = ((targetPos & 0x3ff) << 4) | 0x05;
+        uint8_t buf[2] = { static_cast<uint8_t>((val >> 8) & 0xff), static_cast<uint8_t>(val & 0xff) };
+        if (::write(m_focusI2cFd, buf, 2) != 2) {
+            qWarning() << "Failed to write DW9714 focus to I2C" << targetPos << ":" << strerror(errno);
+        }
+        m_hardwareFocusPos = targetPos;
+        return;
+    }
+
+    int delta = targetPos - m_hardwareFocusPos;
+    if (std::abs(delta) <= 20) {
+        // Small incremental step (e.g. fine slider drag or small AF step)
+        uint16_t val = ((targetPos & 0x3ff) << 4) | 0x05;
+        uint8_t buf[2] = { static_cast<uint8_t>((val >> 8) & 0xff), static_cast<uint8_t>(val & 0xff) };
+        if (::write(m_focusI2cFd, buf, 2) != 2) {
+            qWarning() << "Failed to write DW9714 focus to I2C" << targetPos << ":" << strerror(errno);
+        }
+        m_hardwareFocusPos = targetPos;
+    } else {
+        // Large jump (presets Macro/Normal/Inf or AF start): ramp in smooth 15-code steps
+        // with 2ms intervals to eliminate mechanical click / spring stress completely
+        int step = (delta > 0) ? 15 : -15;
+        int p = m_hardwareFocusPos;
+        while ((step > 0 && p < targetPos) || (step < 0 && p > targetPos)) {
+            p += step;
+            if ((step > 0 && p > targetPos) || (step < 0 && p < targetPos)) {
+                p = targetPos;
+            }
+            uint16_t val = ((p & 0x3ff) << 4) | 0x05;
+            uint8_t buf[2] = { static_cast<uint8_t>((val >> 8) & 0xff), static_cast<uint8_t>(val & 0xff) };
+            ::write(m_focusI2cFd, buf, 2);
+            QThread::msleep(2);
+        }
+        m_hardwareFocusPos = targetPos;
+    }
+}
+
+void PlasmaCamera::setFocusPosition(int pos)
+{
+    if (m_focusFd < 0 && m_focusI2cFd < 0) {
+        return;
+    }
+
+    pos = std::clamp(pos, m_focusMin, m_focusMax);
+    m_focusPosition = pos;
+    Q_EMIT focusPositionChanged();
+
+    if (m_initialFocusPending) {
+        return;
+    }
+
+    writeFocusHardware(pos);
+}
+
+void PlasmaCamera::setSoftwareRotationDegrees(int deg)
+{
+    deg = ((deg % 360) + 360) % 360;
+    if (m_softwareRotationDegrees != deg) {
+        m_softwareRotationDegrees = deg;
+        Q_EMIT softwareRotationDegreesChanged();
+    }
+}
+
+void PlasmaCamera::cycleRotation()
+{
+    setSoftwareRotationDegrees(m_softwareRotationDegrees + 90);
+}
+
+void PlasmaCamera::initFocusActuator()
+{
+    cleanupFocusActuator();
+
+    QDir dir(QStringLiteral("/sys/class/video4linux"));
+    const QStringList subdevs = dir.entryList(QStringList() << QStringLiteral("v4l-subdev*"), QDir::Dirs);
+    QString vcmPath;
+
+    for (const QString &subdev : subdevs) {
+        QFile nameFile(dir.filePath(subdev + QStringLiteral("/name")));
+        if (nameFile.open(QIODevice::ReadOnly | QIODevice::Text)) {
+            QString name = QString::fromUtf8(nameFile.readAll()).trimmed();
+            nameFile.close();
+            if (name.contains(QStringLiteral("dw9714"), Qt::CaseInsensitive) ||
+                name.contains(QStringLiteral("dw9768"), Qt::CaseInsensitive) ||
+                name.contains(QStringLiteral("vcm"), Qt::CaseInsensitive) ||
+                name.contains(QStringLiteral("focus"), Qt::CaseInsensitive)) {
+                vcmPath = QStringLiteral("/dev/") + subdev;
+                qInfo() << "Found focus VCM subdevice:" << vcmPath << "(" << name << ")";
+                break;
+            }
+        }
+    }
+
+    if (!vcmPath.isEmpty()) {
+        int fd = ::open(vcmPath.toUtf8().constData(), O_RDWR | O_NONBLOCK);
+        if (fd >= 0) {
+            struct v4l2_queryctrl qctrl;
+            memset(&qctrl, 0, sizeof(qctrl));
+            qctrl.id = V4L2_CID_FOCUS_ABSOLUTE;
+            if (::ioctl(fd, VIDIOC_QUERYCTRL, &qctrl) == 0 && !(qctrl.flags & V4L2_CTRL_FLAG_DISABLED)) {
+                m_focusFd = fd;
+                m_focusMin = qctrl.minimum;
+                m_focusMax = qctrl.maximum;
+                m_focusStep = qctrl.step > 0 ? qctrl.step : 1;
+                m_focusSupported = true;
+                qInfo() << "VCM focus supported via v4l-subdev, range [" << m_focusMin << ".." << m_focusMax << "], step" << m_focusStep;
+            } else {
+                qWarning() << "V4L2_CID_FOCUS_ABSOLUTE not supported on" << vcmPath;
+                ::close(fd);
+            }
+        } else {
+            qWarning() << "Failed to open VCM device" << vcmPath << ":" << strerror(errno);
+        }
+    }
+
+    // Direct DW9714 I2C access on Qualcomm CCI adapter (/dev/i2c-20 at 0x0c)
+    int i2cfd = ::open("/dev/i2c-20", O_RDWR | O_NONBLOCK);
+    if (i2cfd >= 0) {
+        const unsigned long I2C_SLAVE_FORCE = 0x0706;
+        if (::ioctl(i2cfd, I2C_SLAVE_FORCE, 0x0c) == 0) {
+            m_focusI2cFd = i2cfd;
+            m_focusSupported = true;
+            qInfo() << "VCM focus supported via direct DW9714 I2C on /dev/i2c-20:0x0c";
+        } else {
+            ::close(i2cfd);
+        }
+    }
+
+    if (m_focusSupported) {
+        m_initialFocusPending = true;
+        Q_EMIT focusSupportedChanged();
+    } else {
+        qWarning() << "No working focus actuator interface found";
+    }
+}
+
+void PlasmaCamera::cleanupFocusActuator()
+{
+    m_initialFocusPending = false;
+    m_hardwareFocusPos = -1;
+    if (m_autoFocusRunning) {
+        m_autoFocusRunning = false;
+        Q_EMIT autoFocusRunningChanged();
+    }
+    if (m_focusFd >= 0) {
+        ::close(m_focusFd);
+        m_focusFd = -1;
+    }
+    if (m_focusI2cFd >= 0) {
+        ::close(m_focusI2cFd);
+        m_focusI2cFd = -1;
+    }
+    if (m_focusSupported) {
+        m_focusSupported = false;
+        Q_EMIT focusSupportedChanged();
+    }
+}
+
+static double computeImageSharpness(const QImage &img)
+{
+    if (img.isNull() || img.width() < 64 || img.height() < 64) {
+        return 0.0;
+    }
+
+    int w = img.width();
+    int h = img.height();
+    int rw = w * 3 / 10;
+    int rh = h * 3 / 10;
+    int x0 = (w - rw) / 2;
+    int y0 = (h - rh) / 2;
+
+    double sumGrad = 0.0;
+    double sumLuma = 0.0;
+    int count = 0;
+
+    int bpp = img.depth() / 8;
+    if (bpp < 3) return 0.0;
+
+    for (int y = y0; y < y0 + rh - 1; y += 2) {
+        const uchar *line1 = img.constScanLine(y);
+        const uchar *line2 = img.constScanLine(y + 1);
+        for (int x = x0; x < x0 + rw - 1; x += 2) {
+            int p00 = line1[x * bpp + 1]; // Green channel
+            int p01 = line1[(x + 1) * bpp + 1];
+            int p10 = line2[x * bpp + 1];
+            int dx = p01 - p00;
+            int dy = p10 - p00;
+            sumGrad += static_cast<double>(dx * dx + dy * dy);
+            sumLuma += static_cast<double>(p00);
+            count++;
+        }
+    }
+
+    if (count == 0) return 0.0;
+    double meanGrad = sumGrad / count;
+    double meanLuma = sumLuma / count;
+    return meanGrad / std::max(meanLuma, 1.0);
+}
+
+void PlasmaCamera::triggerAutoFocus()
+{
+    if ((m_focusFd < 0 && m_focusI2cFd < 0) || m_autoFocusRunning) {
+        return;
+    }
+
+    qInfo() << "Starting smooth Auto Focus sweep...";
+    m_afSweepPositions = { 40, 80, 120, 160, 200, 240, 280, 320, 360 };
+    m_afSharpnessValues.clear();
+    m_afStepIndex = 0;
+    m_afFrameSkip = 2;
+    m_bestAfPos = m_focusPosition;
+    m_bestAfSharpness = -1.0;
+    m_autoFocusRunning = true;
+    Q_EMIT autoFocusRunningChanged();
+
+    setFocusPosition(m_afSweepPositions[0]);
+}
+
+void PlasmaCamera::handleViewfinderFrameForAf(const QImage &frame)
+{
+    if (m_initialFocusPending && (m_focusFd >= 0 || m_focusI2cFd >= 0)) {
+        m_initialFocusPending = false;
+        setFocusPosition(m_focusPosition);
+    }
+
+    if (!m_autoFocusRunning || (m_focusFd < 0 && m_focusI2cFd < 0)) {
+        return;
+    }
+
+    if (m_afFrameSkip > 0) {
+        m_afFrameSkip--;
+        return;
+    }
+
+    double sharpness = computeImageSharpness(frame);
+    m_afSharpnessValues.append(sharpness);
+    int currentStep = m_afStepIndex;
+    int currentPos = m_afSweepPositions.value(currentStep);
+
+    qDebug() << "AF step" << currentStep << "pos" << currentPos << "sharpness" << sharpness;
+
+    if (sharpness > m_bestAfSharpness) {
+        m_bestAfSharpness = sharpness;
+        m_bestAfPos = currentPos;
+    }
+
+    m_afStepIndex++;
+    if (m_afStepIndex < m_afSweepPositions.size()) {
+        setFocusPosition(m_afSweepPositions[m_afStepIndex]);
+        m_afFrameSkip = 2;
+    } else {
+        int bestIdx = 0;
+        double maxSharpness = -1.0;
+        for (int i = 0; i < m_afSharpnessValues.size(); ++i) {
+            if (m_afSharpnessValues[i] > maxSharpness) {
+                maxSharpness = m_afSharpnessValues[i];
+                bestIdx = i;
+            }
+        }
+
+        int finalPos = m_afSweepPositions.value(bestIdx);
+
+        if (bestIdx > 0 && bestIdx < m_afSharpnessValues.size() - 1) {
+            double y1 = m_afSharpnessValues[bestIdx - 1];
+            double y2 = m_afSharpnessValues[bestIdx];
+            double y3 = m_afSharpnessValues[bestIdx + 1];
+            double denom = y1 - 2.0 * y2 + y3;
+            if (denom < -1e-6) {
+                double h = 40.0;
+                double delta = (h / 2.0) * (y1 - y3) / denom;
+                delta = std::clamp(delta, -h, h);
+                finalPos = std::clamp(qRound(finalPos + delta), m_focusMin, m_focusMax);
+                qInfo() << "AF parabolic peak interpolated:" << finalPos << "(delta:" << delta << ")";
+            }
+        }
+
+        qInfo() << "AF finished. Optimal position:" << finalPos << "sharpness:" << maxSharpness;
+        setFocusPosition(finalPos);
+        m_autoFocusRunning = false;
+        Q_EMIT autoFocusRunningChanged();
+    }
+}
