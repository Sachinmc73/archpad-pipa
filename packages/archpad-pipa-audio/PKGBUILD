# Maintainer: ArchPad Project <https://github.com/pipa-mainline>
pkgname=archpad-pipa-audio
pkgver=1.0.0
pkgrel=2
pkgdesc="ALSA UCM audio configuration for Xiaomi Pad 6 (pipa)"
arch=('any')
url="https://github.com/pipa-mainline"
license=('BSD-3-Clause')
depends=('alsa-ucm-conf')
source=("pipa.conf"
        "HiFi.conf")
sha512sums=('007908c49db107dd8289a96049ed4d77a55c7846e21f76fa7f97306df953ccdec7d821cbc7732a3ff7c532285175ebf0d6a4e3f224740ac002b23f3608cbf76d'
            '46cc2c08ff524038742d3b257368e9568a59a88ecf6d0a760347bae669a8dcc22d41462cd1a60476b4cab43797d5f62a997d36e659f242ed6981e18dbfd05238')

package() {
  install -Dm644 "${srcdir}/pipa.conf" -t "${pkgdir}/usr/share/alsa/ucm2/Xiaomi/pipa/"
  install -Dm644 "${srcdir}/HiFi.conf" -t "${pkgdir}/usr/share/alsa/ucm2/Xiaomi/pipa/"

  mkdir -p "${pkgdir}/usr/share/alsa/ucm2/conf.d/sm8250"
  ln -s "../../Xiaomi/pipa/pipa.conf" \
    "${pkgdir}/usr/share/alsa/ucm2/conf.d/sm8250/xiaomi-XiaomiPad6.conf"
}
