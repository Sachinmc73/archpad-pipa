[Unit]
Description=ArchPad tablet shell
Documentation=file:/usr/share/doc/archpad-shell/README.md
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/quickshell --path /usr/share/archpad-shell/shell.qml
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
