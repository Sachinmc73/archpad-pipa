From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ArchPad project <archpad@localhost>
Date: Thu, 10 Sep 2026 20:20:00 +0530
Subject: [PATCH] arm64: dts: qcom: sm8250-xiaomi-pipa: enable rear camera vcm
 power rail and fix rotation

Set vreg_l7c_2p85 (PM8150C LDO 7) as regulator-always-on and regulator-boot-on
to supply 2.85V to the Dongwoon DW9714 Voice Coil Motor (VCM) actuator at
I2C address 0x0c on CCI0.

Also correct the sensor orientation rotation property from 270 to 90
to match the hardware sensor roll angle from Xiaomi pipa vendor device
tree (sensor-position-roll = <90>).
---
 .../dts/qcom/sm8250-xiaomi-pipa-common.dtsi   | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-common.dtsi b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-common.dtsi
--- a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-common.dtsi
@@ -558,6 +558,8 @@
 			regulator-min-microvolt = <2856000>;
 			regulator-max-microvolt = <3104000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+			regulator-boot-on;
 		};
 
 		vreg_l8c_1p8: ldo8 {
@@ -628,7 +630,7 @@
 		pinctrl-names = "default";
 
 		orientation = <1>; /* Rear facing */
-		rotation = <270>;
+		rotation = <90>;
 
 		port {
-- 
