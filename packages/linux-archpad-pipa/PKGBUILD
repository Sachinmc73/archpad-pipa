prepare() {
  cd "linux-${pkgver}"

  local patch
  for patch in "${_patches[@]}"; do
    patch -Np1 < "${srcdir}/${patch}"
  done

  cp "${srcdir}/config-xiaomi-pipa.aarch64" .config
  make \
    ARCH=arm64 \
    LLVM=1 \
    LOCALVERSION="${_localversion}" \
    KCFLAGS="${_debug_prefix_map}" \
    KAFLAGS="${_debug_prefix_map}" \
    KRUSTFLAGS="${_rust_prefix_map}" \
    olddefconfig
}

build() {
  cd "linux-${pkgver}"

  make \
    ARCH=arm64 \
    LLVM=1 \
    LOCALVERSION="${_localversion}" \
    KCFLAGS="${_debug_prefix_map}" \
    KAFLAGS="${_debug_prefix_map}" \
    KRUSTFLAGS="${_rust_prefix_map}" \
    KBUILD_BUILD_TIMESTAMP="${_build_epoch}" \
    KBUILD_BUILD_USER='archpad' \
    KBUILD_BUILD_HOST='builder' \
    KBUILD_BUILD_VERSION="${pkgrel}-archpad-${_flavor}"
}

package() {
  cd "linux-${pkgver}"

  local kernelrelease
  kernelrelease="$(make -s ARCH=arm64 LLVM=1 \
    LOCALVERSION="${_localversion}" \
    KCFLAGS="${_debug_prefix_map}" \
    KAFLAGS="${_debug_prefix_map}" \
    KRUSTFLAGS="${_rust_prefix_map}" kernelrelease)"

  make \
    ARCH=arm64 \
    LLVM=1 \
    LOCALVERSION="${_localversion}" \
    KCFLAGS="${_debug_prefix_map}" \
    KAFLAGS="${_debug_prefix_map}" \
    KRUSTFLAGS="${_rust_prefix_map}" \
    INSTALL_MOD_PATH="${pkgdir}/usr" \
    INSTALL_MOD_STRIP=1 \
    modules_install

  rm -f "${pkgdir}/usr/lib/modules/${kernelrelease}/build"
  rm -f "${pkgdir}/usr/lib/modules/${kernelrelease}/source"

  install -Dm644 arch/arm64/boot/Image "${pkgdir}/boot/Image"
  install -Dm644 \
    arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-tianma.dtb \
    "${pkgdir}/boot/dtbs/qcom/sm8250-xiaomi-pipa-tianma.dtb"
  install -Dm644 System.map "${pkgdir}/boot/System.map-${kernelrelease}"
  install -Dm644 .config "${pkgdir}/boot/config-${kernelrelease}"
  install -Dm644 include/config/kernel.release \
    "${pkgdir}/usr/share/kernel/archpad-pipa/kernel.release"
}
