From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ArchPad project <archpad@localhost>
Date: Sun, 6 Sep 2026 00:00:00 +0530
Subject: [PATCH] arm64: dts: qcom: sm8250-xiaomi-pipa: add front camera

Describe the AAC HI846W front camera using the electrical parameters and
wiring from Xiaomi's pipa-t-oss device tree. The sensor is fixed-focus and
uses CCI1 master 1, CSI PHY 4, MCLK3, and four CSI-2 data lanes.

The front-camera analog rail is a 2.8 V fixed regulator controlled by GPIO84.
The remaining rails are PM8150A L1 (1.8 V) and L2 (1.2 V). GPIO109 is RESETB
and GPIO97 is MCLK3.
---
 .../dts/qcom/sm8250-xiaomi-pipa-common.dtsi   | 90 ++++++++++++++++++-
 1 file changed, 89 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-common.dtsi b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-common.dtsi
--- a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-common.dtsi
@@ -98,6 +98,17 @@
 		vin-supply = <&vreg_bob>;
 	};
 
+	camera_front_vana: camera-front-vana-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_front_vana";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		regulator-enable-ramp-delay = <135>;
+		enable-active-high;
+		gpio = <&tlmm 84 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&vreg_bob>;
+	};
+
 	display_panel_dvdd_buck: display-dvdd-ldo-dvdd_buck {
 		compatible = "regulator-fixed";
 		regulator-name = "display_panel_dvdd_buck";
@@ -487,7 +498,12 @@
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
-		/* L2 is unused. */
+		vreg_l2c_1p2: ldo2 {
+			regulator-name = "vreg_l2c_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
 
 		vreg_l4c_1p8: ldo4 {
 			regulator-name = "vreg_l4c_1p8";
@@ -579,6 +595,15 @@
 				remote-endpoint = <&camera_ov13b10_ep>;
 			};
 		};
+
+		port@4 {
+			csiphy4_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&camera_hi846_ep>;
+			};
+		};
 	};
 };
 
@@ -616,6 +641,38 @@
 	};
 };
 
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	camera_front: camera@20 {
+		compatible = "hynix,hi846";
+		reg = <0x20>;
+		vddio-supply = <&vreg_l1c_1p8>;
+		vdda-supply = <&camera_front_vana>;
+		vddd-supply = <&vreg_l2c_1p2>;
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&camera_front_active>;
+		pinctrl-1 = <&camera_front_sleep>;
+		pinctrl-names = "default", "sleep";
+		orientation = <0>; /* Front facing */
+		rotation = <270>;
+
+		port {
+			camera_hi846_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <144000000 288000000 360000000 576000000 720000000>;
+				remote-endpoint = <&csiphy4_ep>;
+			};
+		};
+	};
+};
+
 &cdsp {
 	firmware-name = "qcom/sm8250/xiaomi/pipa/cdsp.mbn";
 	status = "okay";
@@ -1483,6 +1540,39 @@
 		drive-strength = <2>;
 	};
 
+	camera_front_active: camera-front-active-state {
+		mclk-pins {
+			pins = "gpio97";
+			function = "cam_mclk";
+			bias-disable;
+			drive-strength = <4>;
+		};
+
+		reset-pins {
+			pins = "gpio109";
+			function = "gpio";
+			bias-disable;
+			drive-strength = <2>;
+		};
+	};
+
+	camera_front_sleep: camera-front-sleep-state {
+		mclk-pins {
+			pins = "gpio97";
+			function = "cam_mclk";
+			bias-pull-down;
+			drive-strength = <4>;
+		};
+
+		reset-pins {
+			pins = "gpio109";
+			function = "gpio";
+			bias-pull-down;
+			drive-strength = <2>;
+			output-low;
+		};
+	};
+
 	panel_dsi_active: panel_dsi_active-state {
 		pins = "gpio75";
 		function = "gpio";
-- 
2.51.0
