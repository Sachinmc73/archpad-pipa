pkgname=archpad-session
pkgver=0.4.3
pkgrel=1
pkgdesc='ArchPad touch-first Wayland session policy'
arch=('aarch64')
url='https://github.com/archpad/archpad'
license=('GPL-3.0-only')
depends=(
  'brightnessctl'
  'foot'
  'gnome-keyring'
  'hypridle>=0.1.8'
  'hyprland>=0.56.2'
  'hyprlock>=0.9.6'
  'hyprpolkitagent'
  'hyprshutdown'
  'iio-sensor-proxy'
  'pipewire'
  'uwsm'
  'wvkbd-mobintl'
  'wireplumber'
  'xdg-desktop-portal'
  'xdg-desktop-portal-hyprland'
)
makedepends=('gcc' 'pkgconf')
source=(
  'archpad-session'
  'archpad-graphical-session.service'
  '60-archpad-power.conf'
  'archpad-rotation.c'
  'archpad-rotation.service'
  'archpad-pwrkey.c'
  'archpad-pwrkey.service'
  '70-archpad-uinput.rules'
  'hyprland.lua'
  'hyprlock.conf'
  'hypridle.conf'
  'archpad-lock'
  'README.md'
)
