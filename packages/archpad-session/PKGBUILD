build() {
  cc ${CFLAGS} ${CPPFLAGS} archpad-rotation.c -o archpad-rotation \
    $(pkg-config --cflags --libs gio-2.0 gio-unix-2.0) ${LDFLAGS}

  cc ${CFLAGS} ${CPPFLAGS} archpad-pwrkey.c -o archpad-pwrkey \
    $(pkg-config --cflags --libs gio-2.0 gio-unix-2.0) ${LDFLAGS}
}

package() {
  install -Dm755 archpad-session "$pkgdir/usr/bin/archpad-session"
  install -Dm644 archpad-graphical-session.service \
    "$pkgdir/usr/lib/systemd/system/archpad-graphical-session.service"
  install -Dm644 60-archpad-power.conf \
    "$pkgdir/usr/lib/systemd/logind.conf.d/60-archpad-power.conf"
  install -Dm644 hyprland.lua \
    "$pkgdir/usr/share/archpad-session/hyprland.lua"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/archpad-session/README.md"

  # Sensor rotation
  install -Dm755 archpad-rotation \
    "$pkgdir/usr/lib/archpad-session/archpad-rotation"
  install -Dm644 archpad-rotation.service \
    "$pkgdir/usr/lib/systemd/user/archpad-rotation.service"

  # Power key management
  install -Dm755 archpad-pwrkey \
    "$pkgdir/usr/lib/archpad-session/archpad-pwrkey"
  install -Dm644 archpad-pwrkey.service \
    "$pkgdir/usr/lib/systemd/user/archpad-pwrkey.service"
  install -Dm644 70-archpad-uinput.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-archpad-uinput.rules"

  # Lock screen and idle integration
  install -Dm644 hyprlock.conf \
    "$pkgdir/etc/xdg/hypr/hyprlock.conf"
  install -Dm644 hypridle.conf \
    "$pkgdir/etc/xdg/hypr/hypridle.conf"
  install -Dm755 archpad-lock \
    "$pkgdir/usr/lib/archpad-session/archpad-lock"

  # Auto-start user services with graphical session
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s /usr/lib/systemd/user/hyprpolkitagent.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/hyprpolkitagent.service"
  ln -s /usr/lib/systemd/user/archpad-rotation.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/archpad-rotation.service"
  ln -s /usr/lib/systemd/user/archpad-pwrkey.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/archpad-pwrkey.service"
  ln -s /usr/lib/systemd/user/hypridle.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/hypridle.service"
}
