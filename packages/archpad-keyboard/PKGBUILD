# Maintainer: ArchPad project
pkgname=archpad-keyboard
pkgver=1.0.0
pkgrel=62
pkgdesc="Touch-first on-screen keyboard for ArchPad"
arch=('aarch64')
url="https://github.com/Sachinmc73/archpad-pipa"
license=('GPL-3.0-or-later' 'Apache-2.0')
depends=(
    'glibc'
    'libstdc++'
    'qt6-base'
    'qt6-declarative'
    'libcanberra'
    'layer-shell-qt'
    'wayland'
    'archpad-futo-swipe'
    'archpad-futo-swipe-en'
)
makedepends=(
    'cmake'
    'extra-cmake-modules'
    'pkgconf'
    'wayland'
    'wayland-protocols'
)

build() {
    cmake -B build -S "$startdir/src" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$startdir/archpad-keyboard.service" "$pkgdir/usr/lib/systemd/user/archpad-keyboard.service"
    install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
    ln -s /usr/lib/systemd/user/archpad-keyboard.service \
        "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/archpad-keyboard.service"

    install -Dm644 "$startdir/AOSP-KEYPRESS-NOTICE" \
        "$pkgdir/usr/share/licenses/$pkgname/AOSP-KEYPRESS-NOTICE"

}
