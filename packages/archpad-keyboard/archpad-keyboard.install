post_install() {
    # Clean up legacy patch/hook files if upgrading from older package
    rm -f /usr/lib/archpad/archpad-lockscreen-patch
    rm -f /usr/share/libalpm/hooks/96-archpad-lockscreen-keyboard.hook
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -rf /usr/local/share/plasma/shells/org.kde.plasma.desktop
}
