post_install() {
    # Clean up legacy patch/hook files if upgrading from older package
    rm -f /usr/lib/archpad/archpad-lockscreen-patch
    rm -f /usr/share/libalpm/hooks/96-archpad-lockscreen-keyboard.hook

    # Create SDDM theme shared directory
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/archpad-sddm.conf 2>/dev/null || true
    fi

    # Synchronize current active lock screen wallpaper if present
    for user_home in /home/*; do
        if [[ -d "$user_home" && -f "$user_home/.config/kscreenlockerrc" ]]; then
            raw_img=$(grep -E '^\s*Image=' "$user_home/.config/kscreenlockerrc" 2>/dev/null | head -n 1 | cut -d'=' -f2- | sed 's|^file://||' | sed 's|^[[:space:]]*||;s|[[:space:]]*$||')
            if [[ -n "$raw_img" && -f "$raw_img" && -d /var/lib/sddm/theme ]]; then
                cp -f "$raw_img" /var/lib/sddm/theme/lockscreen-wallpaper.png 2>/dev/null || true
                chmod 644 /var/lib/sddm/theme/lockscreen-wallpaper.png 2>/dev/null || true
                chown sddm:users /var/lib/sddm/theme/lockscreen-wallpaper.png 2>/dev/null || true
                break
            fi
        fi
    done

    # Ensure SDDM kwinoutputconfig.json matches landscape display orientation
    if [[ -d /var/lib/sddm/.config && -f /home/archpad/.config/kwinoutputconfig.json ]]; then
        cp -f /home/archpad/.config/kwinoutputconfig.json /var/lib/sddm/.config/kwinoutputconfig.json 2>/dev/null || true
        chown -R sddm:sddm /var/lib/sddm/.config 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -rf /usr/local/share/plasma/shells/org.kde.plasma.desktop
}
