# Enable iio-sensor-proxy's experimental SSC accelerometer only on pipa's
# Sensor DSP and map its axes to the built-in display.
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="archpad-hexagonrpcd-sdsp.service", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel", ENV{ACCEL_MOUNT_MATRIX}="-1, 0, 0; 0, -1, 0; 0, 0, -1"
