#!/bin/bash
set -euo pipefail

LOCK_UI="/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/LockScreenUi.qml"
if [ ! -f "$LOCK_UI" ]; then
    exit 0
fi

if grep -q "ArchpadLockKeyboard" "$LOCK_UI"; then
    exit 0
fi

if grep -q "VirtualKeyboardLoader" "$LOCK_UI"; then
    cp -n "$LOCK_UI" "${LOCK_UI}.orig" 2>/dev/null || true
    sed -i 's/VirtualKeyboardLoader/ArchpadLockKeyboard/g' "$LOCK_UI"
fi
