[Unit]
Description=ArchPad Hardware Power Management Daemon
Documentation=https://github.com/pipa-mainline
After=dbus.service sys-devices-system-cpu.device

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/archpad-powerd
Restart=on-failure
RestartSec=2
ProtectSystem=full
ConfigurationDirectory=archpad
StateDirectory=archpad

[Install]
WantedBy=multi-user.target
Alias=power-profiles-daemon.service
