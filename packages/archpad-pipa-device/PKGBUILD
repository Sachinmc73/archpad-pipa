        "10-archpad-networkmanager.conf"
        "10-archpad-bluetooth.conf"
        "local-overrides.quirks"
        "archpad-hexagonrpcd-sdsp.service"
        "archpad-wait-ssc"
        "archpad-audio-reprobe"
        "archpad-audio-reprobe.service"
        "audio-reprobe.txt"
        "archpad-pipa-modules.conf"
        "archpad-usb-gadget"
        "archpad-usb-gadget.service"
        "80-usb0.network"
        "archpad-wait-sensor-proxy"
        "archpad-pwrkey.c"
        "archpad-pwrkey.service"
        "60-archpad-power.conf"
        "99-archpad-vm.conf"
        "10-archpad-sensors-sleep.sh"
        "60-archpad-powerdevil.conf"
        "10-archpad-power.rules"
        "60-archpad-pm.rules"
        "archpad-power.conf"
        "archpad-powerd"
        "archpad-powerctl"
        "archpad-powerd.service"
        "net.hadess.PowerProfiles.conf")
