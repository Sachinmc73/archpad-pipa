install=archpad-pipa-device.install
depends=('archpad-pipa-firmware>=1.0.0-2' 'hexagonrpc>=0.4.0-3'
         'iio-sensor-proxy>=3.9-2' 'libssc>=0.4.4' 'systemd' 'udev'
         'networkmanager' 'bluez' 'bluez-utils' 'bluedevil' 'glib2')
makedepends=('gcc' 'pkgconf')
source=("81-libssc-xiaomi-pipa.rules"
        "82-archpad-bluetooth.rules"
        "83-archpad-camera.rules"
        "70-archpad-uinput.rules"
        "10-archpad-sensors.conf"
        "10-archpad-networkmanager.conf"
        "10-archpad-bluetooth.conf"
        "local-overrides.quirks"
        "archpad-hexagonrpcd-sdsp.service"
        "archpad-wait-ssc"
        "archpad-audio-reprobe"
        "archpad-audio-reprobe.service"
        "audio-reprobe.txt"
        "archpad-pipa-modules.conf"
        "archpad-usb-gadget"
        "archpad-usb-gadget.service"
        "80-usb0.network"
        "archpad-wait-sensor-proxy"
        "10-archpad-display-manager.conf"
        "archpad-pwrkey.c"
        "archpad-pwrkey.service"
        "60-archpad-power.conf")
