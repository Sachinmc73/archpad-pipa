         'networkmanager' 'bluez' 'bluez-utils' 'bluedevil' 'glib2'
         'python' 'python-gobject')
optdepends=('libkscreen: dynamic display refresh rate switching under Wayland')
provides=('power-profiles-daemon')
conflicts=('power-profiles-daemon')
makedepends=('gcc' 'pkgconf')
