build() {
  cd "${srcdir}"
  cc ${CFLAGS} ${CPPFLAGS} archpad-pwrkey.c -o archpad-pwrkey \
    $(pkg-config --cflags --libs gio-2.0 gio-unix-2.0) ${LDFLAGS}
}

package() {
  install -Dm644 "${srcdir}/81-libssc-xiaomi-pipa.rules" -t "${pkgdir}/usr/lib/udev/rules.d/"
  install -Dm644 "${srcdir}/82-archpad-bluetooth.rules" -t "${pkgdir}/usr/lib/udev/rules.d/"
  install -Dm644 "${srcdir}/83-archpad-camera.rules" -t "${pkgdir}/usr/lib/udev/rules.d/"
  install -Dm644 "${srcdir}/70-archpad-uinput.rules" -t "${pkgdir}/usr/lib/udev/rules.d/"
  install -Dm644 "${srcdir}/60-archpad-pm.rules" -t "${pkgdir}/usr/lib/udev/rules.d/"
  install -Dm644 "${srcdir}/10-archpad-sensors.conf" \
    "${pkgdir}/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-archpad-sensors.conf"
  install -Dm644 "${srcdir}/10-archpad-bluetooth.conf" \
    "${pkgdir}/usr/lib/systemd/system/bluetooth.service.d/10-archpad-bluetooth.conf"
  install -Dm644 "${srcdir}/10-archpad-networkmanager.conf" \
    "${pkgdir}/usr/lib/NetworkManager/conf.d/10-archpad.conf"
  install -Dm644 "${srcdir}/local-overrides.quirks" -t "${pkgdir}/usr/share/libinput/"
  install -Dm644 "${srcdir}/archpad-hexagonrpcd-sdsp.service" \
    -t "${pkgdir}/usr/lib/systemd/system/"
  install -Dm755 "${srcdir}/archpad-wait-ssc" -t "${pkgdir}/usr/lib/archpad/"
  install -Dm755 "${srcdir}/archpad-wait-sensor-proxy" -t "${pkgdir}/usr/lib/archpad/"
  install -Dm755 "${srcdir}/archpad-audio-reprobe" -t "${pkgdir}/usr/lib/archpad/"
  install -Dm644 "${srcdir}/archpad-audio-reprobe.service" -t "${pkgdir}/usr/lib/systemd/system/"
  install -Dm644 "${srcdir}/audio-reprobe.txt" \
    "${pkgdir}/usr/share/doc/archpad/audio-reprobe.txt"
  install -Dm644 "${srcdir}/archpad-pipa-modules.conf" "${pkgdir}/usr/lib/modules-load.d/archpad-pipa.conf"
  install -Dm755 "${srcdir}/archpad-usb-gadget" "${pkgdir}/usr/bin/archpad-usb-gadget"
  install -Dm644 "${srcdir}/archpad-usb-gadget.service" -t "${pkgdir}/usr/lib/systemd/system/"
  install -Dm644 "${srcdir}/80-usb0.network" -t "${pkgdir}/usr/lib/systemd/network/"
  install -Dm644 "${srcdir}/99-archpad-vm.conf" -t "${pkgdir}/usr/lib/sysctl.d/"

  # Standby & Suspend power management
  install -Dm755 "${srcdir}/10-archpad-sensors-sleep.sh" \
    "${pkgdir}/usr/lib/systemd/system-sleep/10-archpad-sensors-sleep.sh"
  install -Dm644 "${srcdir}/60-archpad-powerdevil.conf" \
    "${pkgdir}/etc/xdg/powerdevilrc"
  install -Dm644 "${srcdir}/10-archpad-power.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/10-archpad-power.rules"

  # ArchPad Power Management Daemon & CLI (archpad-powerd / archpad-powerctl)
  install -Dm755 "${srcdir}/archpad-powerd" "${pkgdir}/usr/bin/archpad-powerd"
  install -Dm755 "${srcdir}/archpad-powerctl" "${pkgdir}/usr/bin/archpad-powerctl"
  ln -sf /usr/bin/archpad-powerctl "${pkgdir}/usr/bin/powerprofilesctl"
  install -Dm644 "${srcdir}/archpad-power.conf" "${pkgdir}/etc/archpad/power.conf"
  install -Dm644 "${srcdir}/archpad-power.conf" "${pkgdir}/usr/share/archpad/power.conf.default"
  install -Dm644 "${srcdir}/archpad-powerd.service" "${pkgdir}/usr/lib/systemd/system/archpad-powerd.service"
  install -Dm644 "${srcdir}/net.hadess.PowerProfiles.conf" "${pkgdir}/usr/share/dbus-1/system.d/net.hadess.PowerProfiles.conf"

  # Tablet power key daemon and logind policy
  install -Dm755 "${srcdir}/archpad-pwrkey" "${pkgdir}/usr/lib/archpad/archpad-pwrkey"
  install -Dm644 "${srcdir}/archpad-pwrkey.service" "${pkgdir}/usr/lib/systemd/user/archpad-pwrkey.service"
  install -d "${pkgdir}/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s /usr/lib/systemd/user/archpad-pwrkey.service \
    "${pkgdir}/usr/lib/systemd/user/graphical-session.target.wants/archpad-pwrkey.service"
  install -Dm644 "${srcdir}/60-archpad-power.conf" \
    "${pkgdir}/usr/lib/systemd/logind.conf.d/60-archpad-power.conf"

  install -d "${pkgdir}/usr/lib/systemd/system-preset"
  printf '%s\n' \
    'enable archpad-audio-reprobe.service' \
    'enable archpad-hexagonrpcd-sdsp.service' \
    'enable archpad-usb-gadget.service' \
    'enable NetworkManager.service' \
    'enable bluetooth.service' \
    'enable archpad-powerd.service' \
    > "${pkgdir}/usr/lib/systemd/system-preset/50-archpad-pipa.preset"
}
