package() {
  install -Dm644 "${srcdir}/81-libssc-xiaomi-pipa.rules" -t "${pkgdir}/usr/lib/udev/rules.d/"
  install -Dm644 "${srcdir}/82-archpad-bluetooth.rules" -t "${pkgdir}/usr/lib/udev/rules.d/"
  install -Dm644 "${srcdir}/10-archpad-sensors.conf" \
    "${pkgdir}/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-archpad-sensors.conf"
  install -Dm644 "${srcdir}/10-archpad-bluetooth.conf" \
    "${pkgdir}/usr/lib/systemd/system/bluetooth.service.d/10-archpad-bluetooth.conf"
  install -Dm644 "${srcdir}/10-archpad-networkmanager.conf" \
    "${pkgdir}/usr/lib/NetworkManager/conf.d/10-archpad.conf"
  install -Dm644 "${srcdir}/local-overrides.quirks" -t "${pkgdir}/usr/share/libinput/"
  install -Dm644 "${srcdir}/archpad-hexagonrpcd-sdsp.service" \
    -t "${pkgdir}/usr/lib/systemd/system/"
  install -Dm755 "${srcdir}/archpad-wait-ssc" -t "${pkgdir}/usr/lib/archpad/"
  install -Dm755 "${srcdir}/archpad-audio-reprobe" -t "${pkgdir}/usr/lib/archpad/"
  install -Dm644 "${srcdir}/archpad-audio-reprobe.service" -t "${pkgdir}/usr/lib/systemd/system/"
  install -Dm644 "${srcdir}/audio-reprobe.txt" \
    "${pkgdir}/usr/share/doc/archpad/audio-reprobe.txt"
  install -Dm644 "${srcdir}/archpad-pipa-modules.conf" "${pkgdir}/usr/lib/modules-load.d/archpad-pipa.conf"
  install -Dm755 "${srcdir}/archpad-usb-gadget" "${pkgdir}/usr/bin/archpad-usb-gadget"
  install -Dm644 "${srcdir}/archpad-usb-gadget.service" -t "${pkgdir}/usr/lib/systemd/system/"
  install -Dm644 "${srcdir}/80-usb0.network" -t "${pkgdir}/usr/lib/systemd/network/"

  install -d "${pkgdir}/usr/lib/systemd/system-preset"
  printf '%s\n' \
    'enable archpad-audio-reprobe.service' \
    'enable archpad-hexagonrpcd-sdsp.service' \
    'enable archpad-usb-gadget.service' \
    'enable NetworkManager.service' \
    'enable bluetooth.service' \
    > "${pkgdir}/usr/lib/systemd/system-preset/50-archpad-pipa.preset"
}
